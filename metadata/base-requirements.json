{
  "version": 1,
  "deny": [
    {
      "id": "unsupported_jvm",
      "description": "Exclude older JVMs",
      "os": null,
      "cmds": [
        "**/java-1.5*/**/java",
        "**/java-1.6*/**/java",
        "**/java-1.7*/**/java",
        "**/java-6*/**/java",
        "**/java-7*/**/java"
      ],
      "args": [],
      "envars": null
    },
    {
      "id": "java8_version",
      "description": "Exclude java -version command",
      "os": null,
      "cmds": [
        "**/java"
      ],
      "args": [
        {
          "args": [
            "-version"
          ],
          "position": null
        }
      ],
      "envars": null
    },
    {
      "id": "java_version",
      "description": "Exclude java --version command",
      "os": null,
      "cmds": [
        "**/java"
      ],
      "args": [
        {
          "args": [
            "--version"
          ],
          "position": null
        }
      ],
      "envars": null
    }
  ],
  "native_deps": {
    "glibc": [
      {
        "arch": "x86",
        "supported": true,
        "description": "glibc on x86 is fully supported, no minimum version required"
      },
      {
        "arch": "x64",
        "supported": true,
        "description": "glibc on x64 is fully supported, no minimum version required"
      },
      {
        "arch": "arm64",
        "supported": true,
        "description": "glibc on arm64 is fully supported, no minimum version required"
      }
    ],
    "musl": [
      {
        "arch": "x86",
        "supported": true,
        "description": "musl on x86 is fully supported, no minimum version required"
      },
      {
        "arch": "x64",
        "supported": true,
        "description": "musl on x64 is fully supported, no minimum version required"
      },
      {
        "arch": "arm64",
        "supported": true,
        "description": "musl on arm64 is fully supported, no minimum version required"
      }
    ]
  }
}
