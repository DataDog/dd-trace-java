apply plugin: 'java'
apply plugin: 'jvm-test-suite'

repositories {
  mavenLocal()

  def proxyUrl = System.getenv("MAVEN_REPOSITORY_PROXY")
  if (proxyUrl) {
    println "Using proxy repository: $proxyUrl"
    maven {
      url = proxyUrl
      allowInsecureProtocol = true
    }
  }

  mavenCentral()
}

testing {
    suites {
        test {
            useJUnitJupiter('5.9.3')

            dependencies {
              implementation 'org.junit.platform:junit-platform-launcher:1.9.3'
              implementation 'org.junit.jupiter:junit-jupiter-api:5.9.3'
              implementation 'org.junit.jupiter:junit-jupiter-engine:5.9.3'
            }
        }
    }
}

// Optional scenarios used to verify empty test task reporting.
tasks.named('test', Test) {
  if (project.hasProperty('emptyTestSelection')) {
    useJUnitPlatform { includeTags 'not-present' }
    if (hasProperty('failOnNoDiscoveredTests')) {
      failOnNoDiscoveredTests = false
    }
  }
  if (project.hasProperty('disableTestInstrumentation')) {
    systemProperty 'dd.integration.junit-5.enabled', 'false'
  }
  if (project.hasProperty('failAfterTests')) {
    doLast { throw new GradleException('Synthetic failure after test execution') }
  }
}
