FROM debian:bookworm-slim

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates && \
    apt-get install -y --only-upgrade ca-certificates && \
    update-ca-certificates -f && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y procps tini build-essential git curl unzip zip && \
    apt-get -y clean && \
    rm -rf /var/lib/apt/lists/*

# install sdkman
COPY .sdkmanrc .
RUN curl -fsSL --retry 5 --retry-delay 2 --retry-connrefused -o /tmp/sdkman-install.sh "https://get.sdkman.io" && \
    bash /tmp/sdkman-install.sh && \
    rm /tmp/sdkman-install.sh
RUN bash -c "source $HOME/.sdkman/bin/sdkman-init.sh && \
    sdk env install && \
    sdk install java 11.0.32.1+1-tem && \
    sdk install java 17.0.21.0+9-tem && \
    sdk flush"

ENV JAVA_11_HOME=/root/.sdkman/candidates/java/11.0.32.1+1-tem
# Keep OkHttp's Java 11 test launcher on the scrubbed image JDK, not a runtime download.
RUN mkdir -p "$HOME/.gradle" && \
    printf '%s\n' \
      "org.gradle.java.installations.paths=$JAVA_11_HOME,$HOME/.sdkman/candidates/java/8.0.372-tem,$HOME/.sdkman/candidates/java/17.0.21.0+9-tem" \
      'org.gradle.java.installations.auto-download=false' > "$HOME/.gradle/gradle.properties"

# Distrust the affected roots before Maven or Gradle downloads any build inputs.
RUN set -eu; \
    keytool="$HOME/.sdkman/candidates/java/17.0.21.0+9-tem/bin/keytool"; \
    find "$HOME/.sdkman/candidates/java" -type f -path '*/lib/security/cacerts' | \
    while IFS= read -r store; do \
      listing=$("$keytool" -list -v -keystore "$store" -storepass changeit); \
      aliases=$(printf '%s\n' "$listing" | \
        awk '/^Alias name: / { alias = substr($0, 13) } /^Owner: .*([eE]mSign (ECC )?Root CA - G[123]|AAA Certificate Services)/ { print alias }'); \
      if [ -n "$aliases" ]; then \
        printf '%s\n' "$aliases" | while IFS= read -r alias; do \
          "$keytool" -delete -keystore "$store" -storepass changeit -alias "$alias"; \
        done; \
      fi; \
    done

RUN mkdir exploration-tests
WORKDIR /exploration-tests
# jsoup
RUN git clone -b jsoup-1.18.1 https://github.com/jhy/jsoup.git
COPY jsoup_exploration-tests.patch .
# fix tests that are failing because checking time to execute
RUN cd jsoup && git apply /exploration-tests/jsoup_exploration-tests.patch
RUN bash -c "source $HOME/.sdkman/bin/sdkman-init.sh && cd jsoup && mvn verify -DskipTests=true"


# Jackson
RUN git clone -b 2.16 https://github.com/FasterXML/jackson-core.git
COPY jackson-core_exploration-tests.patch .
# fix tests that are failing because timeout
RUN cd jackson-core && git apply /exploration-tests/jackson-core_exploration-tests.patch
RUN bash -c "source $HOME/.sdkman/bin/sdkman-init.sh && cd jackson-core && mvn verify -DskipTests=true"
RUN git clone -b 2.16 https://github.com/FasterXML/jackson-databind.git
COPY jackson-databind_exploration-tests.patch .
# fix tests that are failing because too deep recursion
RUN cd jackson-databind && git apply /exploration-tests/jackson-databind_exploration-tests.patch
RUN bash -c "source $HOME/.sdkman/bin/sdkman-init.sh && cd jackson-databind && mvn verify -DskipTests=true"

