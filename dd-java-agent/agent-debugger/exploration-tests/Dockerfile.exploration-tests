# okhttp
RUN git clone -b okhttp_5.3.x https://github.com/square/okhttp.git
COPY okhttp_exploration-tests.patch .
RUN cd okhttp && git apply /exploration-tests/okhttp_exploration-tests.patch
RUN bash -c "source $HOME/.sdkman/bin/sdkman-init.sh && sdk use java 17.0.21.0+9-tem && cd okhttp && ./gradlew dependencies"

# Older google-api-client artifacts embed independent Google truststores.
RUN set -eu; \
    keytool="$HOME/.sdkman/candidates/java/17.0.21.0+9-tem/bin/keytool"; \
    find "$HOME/.gradle" -type f -name 'google-api-client-*.jar' | \
    while IFS= read -r archive; do \
      for entry in com/google/api/client/googleapis/google.p12 com/google/api/client/googleapis/google.jks; do \
        if unzip -Z1 "$archive" | grep -Fxq "$entry"; then \
          scratch="$(mktemp -d)"; \
          mkdir -p "$scratch/com/google/api/client/googleapis"; \
          unzip -p "$archive" "$entry" > "$scratch/$entry"; \
          listing=$("$keytool" -list -v -keystore "$scratch/$entry" -storepass notasecret); \
          aliases=$(printf '%s\n' "$listing" | \
            awk '/^Alias name: / { alias = substr($0, 13) } /^Owner: .*([eE]mSign (ECC )?Root CA - G[123]|AAA Certificate Services)/ { print alias }'); \
          if [ -n "$aliases" ]; then \
            printf '%s\n' "$aliases" | while IFS= read -r alias; do \
              "$keytool" -delete -keystore "$scratch/$entry" -storepass notasecret -alias "$alias"; \
            done; \
            (cd "$scratch" && zip -q "$archive" "$entry"); \
          fi; \
          rm -rf "$scratch"; \
        fi; \
      done; \
    done

# Do not publish Gradle's generated API jar with its old embedded CA snapshot.
RUN if [ -d "$HOME/.gradle/caches" ]; then \
      find "$HOME/.gradle/caches" -type f -path '*/generated-gradle-jars/gradle-api-*.jar' -delete; \
    fi
