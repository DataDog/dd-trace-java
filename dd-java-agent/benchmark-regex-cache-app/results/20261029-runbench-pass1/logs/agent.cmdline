/Library/Java/JavaVirtualMachines/zulu-21.jdk/Contents/Home/bin/java
-Xms512m
-Xmx512m
-XX:+UseG1GC
-javaagent:<repo>/dd-java-agent/build/libs/dd-java-agent-1.68.0-SNAPSHOT.jar
-Ddd.service=regex-bench
-Ddd.env=bench
-Ddd.version=1
-Ddd.trace.enabled=true
-Ddd.trace.agent.url=http://127.0.0.1:18126
-Ddd.remote_config.enabled=false
-Ddd.telemetry.enabled=false
-Ddd.profiling.enabled=false
-Ddd.appsec.enabled=false
-Ddd.iast.enabled=false
-Ddd.dynamic.instrumentation.enabled=false
-Ddd.data.streams.enabled=false
-Ddd.jmxfetch.enabled=false
