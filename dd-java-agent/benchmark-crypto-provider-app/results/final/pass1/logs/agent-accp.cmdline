/opt/java/openjdk/bin/java
-Xms512m
-Xmx512m
-XX:+UseG1GC
-Dbench.https.cert=rsa
-javaagent:<repo>/dd-java-agent/build/libs/dd-java-agent-1.68.0-SNAPSHOT.jar
-Ddd.service=crypto-bench
-Ddd.env=bench
-Ddd.version=1
-Ddd.trace.enabled=true
-Ddd.trace.agent.url=http://127.0.0.1:18126
-Ddd.remote_config.enabled=false
-Ddd.telemetry.enabled=false
-Ddd.profiling.enabled=false
-Ddd.appsec.enabled=false
-Ddd.iast.enabled=false
-Ddd.dynamic.instrumentation.enabled=false
-Ddd.data.streams.enabled=false
-Ddd.jmxfetch.enabled=false
-Ddd.trace.health.metrics.enabled=false
-Ddd.trace.stats.computation.enabled=false
-Ddd.crashtracking.enabled=false
-Ddd.trace.startup.logs=false
-Ddd.trace.experimental.crypto.provider.enabled=true
-DPORT=18080
-DHTTPS_PORT=18443
-cp
<repo>/dd-java-agent/benchmark-crypto-provider-app/build/app/lib/*:<repo>/dd-java-agent/benchmark-crypto-provider-app/build/accp/AmazonCorrettoCryptoProvider-2.5.0-linux-aarch_64.jar
com.example.cryptobench.CryptoBenchApplication
